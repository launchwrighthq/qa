{
  "name": "@launchwrighthq/qa",
  "version": "0.1.5",
  "license": "MIT",
  "description": "A standalone, public QA library for AI products: QA passes with evidence, personas, state triggers, devices, fake Telegram, issue intake, a reviewer-comment viewer and a score.",
  "type": "module",
  "private": true,
  "bin": {
    "lw-qa": "./bin/lw-qa.mjs"
  },
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./world": {
      "import": { "types": "./dist/world.d.ts", "default": "./dist/world.js" },
      "require": { "types": "./dist/world.d.cts", "default": "./dist/world.cjs" }
    },
    "./states": {
      "import": { "types": "./dist/states.d.ts", "default": "./dist/states.js" },
      "require": { "types": "./dist/states.d.cts", "default": "./dist/states.cjs" }
    },
    "./testing": {
      "import": { "types": "./dist/testing.d.ts", "default": "./dist/testing.js" },
      "require": { "types": "./dist/testing.d.cts", "default": "./dist/testing.cjs" }
    },
    "./sink": {
      "import": { "types": "./dist/sink.d.ts", "default": "./dist/sink.js" },
      "require": { "types": "./dist/sink.d.cts", "default": "./dist/sink.cjs" }
    },
    "./render": {
      "import": { "types": "./dist/render.d.ts", "default": "./dist/render.js" },
      "require": { "types": "./dist/render.d.cts", "default": "./dist/render.cjs" }
    },
    "./intake": {
      "import": { "types": "./dist/intake.d.ts", "default": "./dist/intake.js" },
      "require": { "types": "./dist/intake.d.cts", "default": "./dist/intake.cjs" }
    },
    "./device": {
      "import": { "types": "./dist/device.d.ts", "default": "./dist/device.js" },
      "require": { "types": "./dist/device.d.cts", "default": "./dist/device.cjs" }
    },
    "./states-host": {
      "import": { "types": "./dist/states-host.d.ts", "default": "./dist/states-host.js" },
      "require": { "types": "./dist/states-host.d.cts", "default": "./dist/states-host.cjs" }
    },
    "./states-host/solid": {
      "import": { "types": "./dist/states-host/solid.d.ts", "default": "./dist/states-host/solid.js" },
      "require": { "types": "./dist/states-host/solid.d.cts", "default": "./dist/states-host/solid.cjs" }
    },
    "./states-host/react": {
      "import": { "types": "./dist/states-host/react.d.ts", "default": "./dist/states-host/react.js" },
      "require": { "types": "./dist/states-host/react.d.cts", "default": "./dist/states-host/react.cjs" }
    },
    "./telegram-fake": {
      "import": { "types": "./dist/telegram-fake.d.ts", "default": "./dist/telegram-fake.js" },
      "require": { "types": "./dist/telegram-fake.d.cts", "default": "./dist/telegram-fake.cjs" }
    }
  },
  "files": [
    "dist",
    "assets",
    "fixtures",
    "src",
    "bin",
    "harness",
    "harness.toml",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "compile": "tsup",
    "test": "vitest run",
    "scan": "node scripts/scan.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@launchwrighthq/auth": "*",
    "@launchwrighthq/client": "*",
    "@launchwrighthq/db": "*",
    "@launchwrighthq/dev": "*",
    "@launchwrighthq/http": "*",
    "@launchwrighthq/queue": "*",
    "@launchwrighthq/storage": "*",
    "@launchwrighthq/tunnel": "*",
    "@playwright/test": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "solid-js": "^1.9.0",
    "telegram": "^2.26.0",
    "vite": "^8.0.0",
    "vitest": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@launchwrighthq/auth": { "optional": true },
    "@launchwrighthq/client": { "optional": true },
    "@launchwrighthq/db": { "optional": true },
    "@launchwrighthq/dev": { "optional": true },
    "@launchwrighthq/http": { "optional": true },
    "@launchwrighthq/queue": { "optional": true },
    "@launchwrighthq/storage": { "optional": true },
    "@launchwrighthq/tunnel": { "optional": true },
    "@playwright/test": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "solid-js": { "optional": true },
    "telegram": { "optional": true },
    "vite": { "optional": true },
    "vitest": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@playwright/test": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "~1.9.18",
    "telegram": "^2.26.22",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "tsup": "^8.3.5"
  }
}
